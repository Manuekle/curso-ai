# Copiá esto a .env y poné las keys que tengas.
# Con 2+ proveedores configurados, si uno falla (key inválida, rate limit, cuota)
# el sistema intenta automáticamente con el siguiente. Sin keys → modo offline local.

# Proveedor 1: OpenAI
OPENAI_API_KEY=sk-tu-key-acá
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Proveedor 2: OpenRouter — si esta key existe, se usa OpenRouter (prioridad)
# Chat gratis: google/gemma-4-26b-a4b-it:free (o el :free que quieras)
# Embeddings gratis: nvidia/nemotron-3-embed-1b:free (ver openrouter.ai/models?output_modalities=embeddings)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Proveedor 3 (opcional): Gemini — embeddings: text-embedding-004
GEMINI_API_KEY=

# Proveedor 4 (opcional): Groq — solo chat, embeddings usan openrouter/openai
GROQ_API_KEY=

# Modelos de razonamiento explícito (solo si el modelo lo soporta; gratis suele no soportarlo)
REASONING=false

PORT=4000