{
  "name": "curso-ai-agentes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch server/server.ts\" \"npm --prefix frontend run dev\"",
    "dev:api": "tsx watch server/server.ts",
    "dev:web": "npm --prefix frontend run dev",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "openai": "^4.67.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
